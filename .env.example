# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง
PORT=3000

# Connection string จาก MongoDB Atlas (ดูวิธีหาใน README.md หัวข้อ "ตั้งค่าฐานข้อมูล")
# ตัวอย่าง: mongodb+srv://myuser:mypassword@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Channel access token จาก LINE Official Account Manager > การตั้งค่า > Messaging API
# (สามารถตั้งค่านี้ได้จากหน้าเว็บในแท็บ "ตั้งค่า" ก็ได้ ไม่จำเป็นต้องใส่ในไฟล์นี้)
LINE_CHANNEL_ACCESS_TOKEN=

# กุญแจลับสำหรับยืนยันว่า request เซ็นเซอร์/อุปกรณ์ IoT มาจากของจริง
SENSOR_API_KEY=changeme123
